# Copy to a private location and fill in the key. Never commit the real file.
TYPESAFE_API_KEY=replace-with-your-key
TYPESAFE_API_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
# Use an absolute path; ~ is not expanded by the client.
JEV_STATE_PATH=/absolute/path/to/.jev_quota_state.json
